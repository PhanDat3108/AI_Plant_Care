NODE_ENV=development
PORT=3100
CORS_ORIGINS=http://localhost:5173
# Mẫu local. Dùng Supabase: nhận .env riêng và xem README.md.
# Runtime Supabase cần sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
DATABASE_URL=postgresql://plant:CHANGE_ME@127.0.0.1:5433/plantcare
DIRECT_URL=postgresql://plant:CHANGE_ME@127.0.0.1:5433/plantcare
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
# Chỉ bật demo cho DB local riêng; Supabase chung phải dùng false.
DEV_AUTH_BYPASS=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Chốt với frontend và thêm vào Supabase Redirect URLs.
AUTH_REDIRECT_URL=
