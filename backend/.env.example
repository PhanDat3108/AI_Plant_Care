# Mẫu chạy local: sao chép thành .env rồi điền giá trị riêng.
# Có đủ tên biến trong hai ảnh Render; giá trị mẫu không phải giá trị production.
NODE_ENV=development
PORT=3100
CORS_ORIGINS=http://localhost:5173
# Supabase: thay bằng chuỗi Connect của project, runtime và migration có thể khác nhau.
DATABASE_URL=postgresql://plant:CHANGE_ME@127.0.0.1:5433/plantcare
DIRECT_URL=postgresql://plant:CHANGE_ME@127.0.0.1:5433/plantcare
# Chỉ dùng để khởi tạo PostgreSQL Docker local.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
# true chỉ cho demo local; dùng false để test tài khoản Supabase thật.
DEV_AUTH_BYPASS=false
# Lấy URL và các key từ CÙNG một Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=plant-images
# Server-only: secret key (hoặc service_role legacy), không đưa vào Flutter/Git.
SUPABASE_SECRET_KEY=

# Email confirmation/recovery callback (local backend diagnostic page).
AUTH_REDIRECT_URL=http://localhost:3100/auth/callback
# Google mobile callback; register this exact URL in Supabase and Flutter.
GOOGLE_AUTH_REDIRECT_URL=vn.aiplantcare.app://auth/callback

# Secret cho POST /api/v1/internal/reminders/run (32–256 ký tự).
# Điền cùng secret trong cấu hình cron-job.org và backend chạy tương ứng.
CRON_SECRET=

# Đổi thành true để gửi push, sau khi cấu hình Firebase và chạy migration push.
# false chỉ tắt gửi push; không phải cấu hình để kiểm thử thông báo đẩy.
PUSH_ENABLED=false
# Render: /etc/secrets/firebase-admin.json
# Local: /Users/<ten-user>/.config/ai-plant-care/firebase-admin.json
# Đây là đường dẫn file service account JSON, không phải nội dung JSON/API key.
GOOGLE_APPLICATION_CREDENTIALS=

# AI: live yêu cầu Gemini key; auto có thể dùng dữ liệu demo khi thiếu key.
# Để kiểm thử AI thật: điền các key rồi đổi CARE_AI_MODE=live.
CARE_AI_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tùy chọn: Supabase Auth UUID của người duyệt dữ liệu, phân cách bằng dấu phẩy.
CARE_REVIEWER_IDS=

# Nhận diện loài qua PlantNet; chẩn đoán bệnh dùng Gemini.
PLANTNET_API_KEY=
PLANTNET_PROJECT=all
# Tương thích cấu hình cũ; ảnh quét hiện được upload lên Supabase Storage.
UPLOAD_DIR=uploads

# Open-Meteo hiện không yêu cầu API key hoặc biến môi trường riêng.
# Render: NODE_ENV=production, DEV_AUTH_BYPASS=false; cấu hình Environment riêng.
# Render gửi push: PUSH_ENABLED=true, GOOGLE_APPLICATION_CREDENTIALS trỏ tới Secret File.
# DATABASE_URL/DIRECT_URL dùng database thực; POSTGRES_* chỉ dành cho Docker local.
# AUTH_REDIRECT_URL dùng callback HTTPS phù hợp bản triển khai;
# GOOGLE_AUTH_REDIRECT_URL giữ deep link đã đăng ký cho app mobile.
# Không dùng URL localhost làm callback cho người dùng điện thoại.
# Nếu DATABASE_URL dùng sslrootcert, file CA phải tồn tại ở đường dẫn trên máy chạy.
