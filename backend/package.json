{
  "name": "ai-plant-care-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/database",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx database/seed.ts",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "env:init": "node scripts/init-env.mjs",
    "db:local": "node scripts/local-db.mjs",
    "test:db:isolated": "node scripts/test-db-isolated.mjs",
    "reminders:run": "tsx src/jobs/reminders.ts",
    "reminders:start": "node dist/jobs/reminders.js",
    "reminders:watch": "tsx src/jobs/reminders.ts --watch",
    "care:check": "tsx src/jobs/check-care.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/supertest": "^6",
    "embedded-postgres": "16.15.0-beta.19",
    "eslint": "^10",
    "prettier": "^3",
    "prisma": "7.10.1",
    "supertest": "^7",
    "tsx": "^4",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8",
    "vitest": "^4"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
