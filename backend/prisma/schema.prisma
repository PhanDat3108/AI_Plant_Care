generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model UserProfile {
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  id            String         @id @db.Uuid
  plants        UserPlant[]
  notifications Notification[]
}

model PlantSpecies {
  id             String      @id @default(uuid()) @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  scientificName String      @unique
  commonName     String
  plants         UserPlant[]
}

model UserPlant {
  id        String         @id @default(uuid()) @db.Uuid
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  ownerId   String         @db.Uuid
  owner     UserProfile    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  speciesId String?        @db.Uuid
  species   PlantSpecies?  @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  name      String
  notes     String         @default("")
  imageKey  String?
  scans     ScanHistory[]
  schedules CareSchedule[]

  @@index([ownerId, createdAt])
}

model ScanHistory {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  plantId   String    @db.Uuid
  plant     UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)
  imageKey  String?
  isMock    Boolean
  result    Json
  diseaseId String?   @db.Uuid
  disease   Disease?  @relation(fields: [diseaseId], references: [id], onDelete: SetNull)

  @@index([plantId, createdAt])
}

model Disease {
  id        String        @id @default(uuid()) @db.Uuid
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  name      String        @unique
  scans     ScanHistory[]
}

model CareSchedule {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  plantId   String    @db.Uuid
  plant     UserPlant @relation(fields: [plantId], references: [id], onDelete: Cascade)
  task      String
  dueAt     DateTime  @db.Timestamptz
  logs      CareLog[]

  @@index([plantId, dueAt])
}

model CareLog {
  id         String       @id @default(uuid()) @db.Uuid
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  scheduleId String       @db.Uuid
  schedule   CareSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  note       String?

  @@index([scheduleId, createdAt])
}

model Notification {
  id        String      @id @default(uuid()) @db.Uuid
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  ownerId   String      @db.Uuid
  owner     UserProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  message   String
  readAt    DateTime?

  @@index([ownerId, createdAt])
}
