{
  "name": "@ai-plant-care/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.x",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "multer": "^2.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/multer": "^2",
    "@types/node": "^24",
    "@types/supertest": "^6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.x",
    "supertest": "^7",
    "tsx": "^4",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8",
    "vitest": "^4"
  }
}
